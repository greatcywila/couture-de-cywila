# ========================================================
# Couture dé Cywila - Environment Variables
# ========================================================
# Configure these in your Netlify Dashboard under:
# Site configuration > Environment variables > Add a variable
# Or in a local .env file when using Netlify CLI ('netlify dev')

# Flutterwave Public Key (Starts with FLWPUBK_TEST- or FLWPUBK-)
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxx-X

# Paystack Public Key (Starts with pk_test_ or pk_live_)
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Resend Email API Key (Get free key from https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ADMIN_NOTIFICATION_EMAIL=greatcywila@gmail.com
# Verified domain sender (e.g. orders@couturedecywila.com.ng) or default onboarding@resend.dev
RESEND_SENDER_EMAIL=onboarding@resend.dev

# (Optional) Supabase Realtime Sync (Get free keys from https://supabase.com)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
