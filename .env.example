# ========================================================
# Couture dé Cywila - Environment Variables
# ========================================================
# Configure these in your Netlify Dashboard under:
# Site configuration > Environment variables > Add a variable
# Or in a local .env file when using Netlify CLI ('netlify dev')

# Flutterwave Public Key (Starts with FLWPUBK_TEST- or FLWPUBK-)
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxx-X

# Paystack Public Key (Starts with pk_test_ or pk_live_)
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
